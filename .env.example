PORT=3000

# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# From https://app.alpaca.markets/paper/dashboard/overview (Paper Trading keys)
ALPACA_API_KEY=your_alpaca_paper_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret

# true = paper-api.alpaca.markets (fake money, real prices). Only set to false
# once you deliberately want to trade with a live, funded Alpaca account.
ALPACA_PAPER=true

# Symbols streamed to the dashboard on connect
WATCH_SYMBOLS=AAPL,MSFT,TSLA,SPY,NVDA
